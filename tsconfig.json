{
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.*"
  ],
  "compilerOptions": {
    "noImplicitAny": true,
    "target": "es2020",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "strictNullChecks": false
  }
}